# Session worktrees (see AGENTS.md § Worktrees)
.worktrees/

# Node tooling (prettier, skills-ref via npx)
node_modules/

# Python bytecode
__pycache__/
*.py[cod]

# Local Claude Code settings (prettier honors .gitignore, so this also
# keeps `just check` green on a working copy that has them)
.claude/settings.local.json

# Build output (see `just bundle <harness>`)
dist/

# pytest
.pytest_cache/

# uv (uv.lock is tracked)
.venv/

# Harness-test runs produced by `just skel-new`.
runs/
